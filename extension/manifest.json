{
  "manifest_version": 3,
  "name": "모아 — 학습자료 캡처",
  "version": "1.2.0",
  "description": "웹페이지의 선택 영역을 변경 감지로 캡처하고, 순서대로 PDF 학습자료를 만듭니다.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "action": {
    "default_title": "모아 학습자료 만들기"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
